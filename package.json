{
  "name": "quiz",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler d1 migrations apply quiz --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply quiz --local",
    "db:migrate:remote": "wrangler d1 migrations apply quiz --remote"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
